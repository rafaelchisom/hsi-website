# Environment variables for Render (Service → Environment). For local Docker
# runs, copy to .env and pass with: docker run --env-file .env ...

# ── Database: Supabase → Project Settings → Database → Connection string ─────
# Use the "Transaction pooler" values (port 6543)
DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASS=your-supabase-db-password
DB_SSL=require

# ── Image uploads: Supabase → Project Settings → API ─────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key
SUPABASE_BUCKET=media

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=https://your-new-domain.org
TRUST_PROXY=true
APP_DEBUG=false
MAIL_FROM=noreply@your-new-domain.org

# ── First admin account (created on first start; remove the password after) ─
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
